# Host bindings
BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=8080
BACKEND_PORT=8000
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5433

# Laravel inside Docker
DOCKER_APP_KEY=base64:R1QhrP6QP/62TMk5IRKJFAlzCFZKuTVKb/QW7AatV5g=
RUN_MIGRATIONS=true
RUN_SEEDERS=false

# PostgreSQL used by backend.
# Default values use the db service from docker-compose.yml.
DOCKER_DB_HOST=db
DOCKER_DB_PORT=5432
DOCKER_DB_DATABASE=plantAssistant
DOCKER_DB_USERNAME=postgres
DOCKER_DB_PASSWORD=password

# Existing PostgreSQL examples:
# 1. If PostgreSQL is exposed on the Windows host:
# DOCKER_DB_HOST=host.docker.internal
# DOCKER_DB_PORT=5432
#
# 2. If PostgreSQL is another container on an existing Docker network:
# DOCKER_DB_HOST=postgres-container-name
# DOCKER_DB_PORT=5432
# EXTERNAL_POSTGRES_NETWORK=existing_network_name
